{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app.js": {
      "includeFiles": [
        "planning/*.sql",
        "node_modules/pdfmake/fonts/Roboto/*.ttf"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
