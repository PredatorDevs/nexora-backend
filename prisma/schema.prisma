  memberships CompanyMembershipRole[]
  permissions CompanyRolePermission[]
  invitations CompanyInvitationRole[]

  @@unique([companyId, code], map: "company_roles_company_code_key")
  @@unique([id, companyId], map: "company_roles_id_company_key")
  @@index([companyId, isSystem], map: "company_roles_company_system_idx")
  @@map("company_roles")
}

model CompanyMembershipRole {
  membershipId     Int               @map("membership_id") @db.UnsignedInt
