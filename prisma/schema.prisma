generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum AuditResult {
  SUCCESS
  FAILURE

  @@map("audit_result")
}

enum EntityChangeOperation {
  CREATE
  UPDATE
  DELETE

  @@map("entity_change_operation")
}

enum EntityChangeSource {
  APPLICATION
  SYSTEM_JOB
  MIGRATION
  DATABASE_TRIGGER

  @@map("entity_change_source")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("company_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("branch_status")
}

enum LocationCapacityUnit {
  UNITS
  KG
  M3
  PALLETS
}

enum CompanyEconomicActivityType {
  PRIMARY
  SECONDARY
  TERTIARY

  @@map("company_economic_activity_type")
}

enum PermissionScope {
  PLATFORM
  COMPANY

  @@map("permission_scope")
}

enum ProductUnitType {
  PURCHASE
  SALE
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IN_QUOTATION
  COMPLETED
  CANCELLED

  @@map("purchase_request_status")
}

enum PurchaseQuotationStatus {
  DRAFT
  RECEIVED
  UNDER_REVIEW
  SELECTED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("purchase_quotation_status")
}

enum CompanyMembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("company_membership_status")
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("company_invitation_status")
}

model User {
  id                           Int                        @id @default(autoincrement()) @db.UnsignedInt
  email                        String                     @unique(map: "users_email_key") @db.VarChar(191)
  passwordHash                 String                     @map("password_hash") @db.VarChar(255)
  displayName                  String                     @map("display_name") @db.VarChar(120)
  status                       UserStatus                 @default(ACTIVE)
  securityVersion              Int                        @default(1) @map("security_version") @db.UnsignedInt
  mustChangePassword           Boolean                    @default(false) @map("must_change_password")
  createdAt                    DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                    DateTime                   @updatedAt @map("updated_at") @db.DateTime(3)
  roles                        UserRole[]                 @relation("UserRoles")
  roleAssignmentsGranted       UserRole[]                 @relation("UserRoleAssignedBy")
  permissionGrantsAssigned     RolePermission[]           @relation("RolePermissionAssignedBy")
  sessions                     AuthSession[]
  auditLogs                    AuditLog[]                 @relation("AuditActor")
  entityChanges                EntityChangeLog[]          @relation("EntityChangeActor")
  companyMemberships           CompanyMembership[]
  companyRolesAssigned         CompanyMembershipRole[]    @relation("CompanyMembershipRoleAssignedBy")
  companyPermissionsAssigned   CompanyRolePermission[]    @relation("CompanyRolePermissionAssignedBy")
  companyInvitationsSent       CompanyInvitation[]        @relation("CompanyInvitationInvitedBy")
  companyInvitationsAccepted   CompanyInvitation[]        @relation("CompanyInvitationAcceptedBy")
  purchaseRequestsRequested    PurchaseRequest[]          @relation("PurchaseRequestRequestedBy")
  purchaseRequestsApproved     PurchaseRequest[]          @relation("PurchaseRequestApprovedBy")
  purchaseRequestsRejected     PurchaseRequest[]          @relation("PurchaseRequestRejectedBy")
  purchaseRequestsCancelled    PurchaseRequest[]          @relation("PurchaseRequestCancelledBy")
  purchaseQuotationsRegistered PurchaseQuotation[]        @relation("PurchaseQuotationRegisteredBy")
  purchaseQuotationsCancelled  PurchaseQuotation[]        @relation("PurchaseQuotationCancelledBy")
  purchaseQuotationsSelected   PurchaseQuotation[]        @relation("PurchaseQuotationSelectedBy")
  purchaseQuotationsRejected   PurchaseQuotation[]        @relation("PurchaseQuotationRejectedBy")
  quotationRequestDecisions    PurchaseQuotationRequest[] @relation("PurchaseQuotationRequestDecidedBy")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  code        String           @unique(map: "roles_code_key") @db.VarChar(100)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       UserRole[]
  permissions RolePermission[]

  @@index([isSystem], map: "roles_is_system_idx")
  @@map("roles")
}

model Permission {
  id           Int                     @id @default(autoincrement()) @db.UnsignedInt
  code         String                  @unique(map: "permissions_code_key") @db.VarChar(150)
  resource     String                  @db.VarChar(75)
  action       String                  @db.VarChar(75)
  description  String?                 @db.VarChar(500)
  scope        PermissionScope         @default(PLATFORM)
  createdAt    DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  roles        RolePermission[]
  companyRoles CompanyRolePermission[]

  @@unique([resource, action], map: "permissions_resource_action_key")
  @@map("permissions")
}

model UserRole {
  userId           Int      @map("user_id") @db.UnsignedInt
  roleId           Int      @map("role_id") @db.UnsignedInt
  assignedByUserId Int?     @map("assigned_by_user_id") @db.UnsignedInt
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  user             User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy       User?    @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId           Int        @map("role_id") @db.UnsignedInt
  permissionId     Int        @map("permission_id") @db.UnsignedInt
  assignedByUserId Int?       @map("assigned_by_user_id") @db.UnsignedInt
  assignedAt       DateTime   @default(now()) @map("assigned_at") @db.DateTime(3)
  role             Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission       Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedBy       User?      @relation("RolePermissionAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@index([assignedByUserId], map: "role_permissions_assigned_by_user_id_idx")
  @@map("role_permissions")
}

model AuthSession {
  id               String             @id @db.Char(36)
  familyId         String             @map("family_id") @db.Char(36)
  userId           Int                @map("user_id") @db.UnsignedInt
  companyId        Int?               @map("company_id") @db.UnsignedInt
  membershipId     Int?               @map("membership_id") @db.UnsignedInt
  refreshTokenHash String             @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  ipAddress        String?            @map("ip_address") @db.VarChar(45)
  userAgent        String?            @map("user_agent") @db.VarChar(512)
  expiresAt        DateTime           @map("expires_at") @db.DateTime(3)
  lastUsedAt       DateTime?          @map("last_used_at") @db.DateTime(3)
  revokedAt        DateTime?          @map("revoked_at") @db.DateTime(3)
  revokedReason    String?            @map("revoked_reason") @db.VarChar(100)
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership       CompanyMembership? @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_state_idx")
  @@index([familyId], map: "auth_sessions_family_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@index([companyId, revokedAt, expiresAt], map: "auth_sessions_company_state_idx")
  @@index([membershipId, companyId], map: "auth_sessions_membership_company_idx")
  @@map("auth_sessions")
}

model AuditLog {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  actorUserId       Int?               @map("actor_user_id") @db.UnsignedInt
  companyId         Int?               @map("company_id") @db.UnsignedInt
  actorMembershipId Int?               @map("actor_membership_id") @db.UnsignedInt
  action            String             @db.VarChar(150)
  resourceType      String             @map("resource_type") @db.VarChar(100)
  resourceId        String?            @map("resource_id") @db.VarChar(191)
  result            AuditResult
  requestId         String             @map("request_id") @db.VarChar(128)
  ipAddress         String?            @map("ip_address") @db.VarChar(45)
  userAgent         String?            @map("user_agent") @db.VarChar(512)
  metadata          Json?
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  actor             User?              @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorMembership   CompanyMembership? @relation(fields: [actorMembershipId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId, createdAt], map: "audit_logs_actor_created_at_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_at_idx")
  @@index([resourceType, resourceId], map: "audit_logs_resource_idx")
  @@index([requestId], map: "audit_logs_request_id_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@index([companyId, createdAt], map: "audit_logs_company_created_at_idx")
  @@index([companyId, actorUserId, createdAt], map: "audit_logs_company_actor_idx")
  @@map("audit_logs")
}

model EntityChangeLog {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  schemaName        String                @map("schema_name") @db.VarChar(100)
  entityType        String                @map("entity_type") @db.VarChar(100)
  entityId          String                @map("entity_id") @db.VarChar(191)
  operation         EntityChangeOperation
  source            EntityChangeSource    @default(APPLICATION)
  actorUserId       Int?                  @map("actor_user_id") @db.UnsignedInt
  companyId         Int?                  @map("company_id") @db.UnsignedInt
  actorMembershipId Int?                  @map("actor_membership_id") @db.UnsignedInt
  requestId         String                @map("request_id") @db.VarChar(128)
  oldValues         Json?                 @map("old_values")
  newValues         Json?                 @map("new_values")
  changedFields     Json?                 @map("changed_fields")
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  actor             User?                 @relation("EntityChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company           Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorMembership   CompanyMembership?    @relation(fields: [actorMembershipId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([schemaName, entityType, entityId, createdAt], map: "entity_change_logs_entity_idx")
  @@index([schemaName, createdAt], map: "entity_change_logs_schema_date_idx")
  @@index([schemaName, entityType, createdAt], map: "entity_change_logs_type_date_idx")
  @@index([actorUserId, createdAt], map: "entity_change_logs_actor_idx")
  @@index([requestId], map: "entity_change_logs_request_id_idx")
  @@index([createdAt], map: "entity_change_logs_created_at_idx")
  @@index([companyId, createdAt], map: "entity_change_logs_company_date_idx")
  @@index([companyId, entityType, entityId, createdAt], map: "entity_change_logs_company_entity_idx")
  @@map("entity_change_logs")
}

model Country {
  id           Int        @id @default(autoincrement()) @db.UnsignedInt
  name         String     @db.VarChar(128)
  abbreviation String     @unique(map: "countries_abbreviation_key") @db.VarChar(5)
  mhCode       String     @unique(map: "countries_mh_code_key") @map("mh_code") @db.VarChar(5)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  companies    Company[]
  branches     Branch[]
  suppliers    Supplier[]

  @@index([isActive, name], map: "countries_active_name_idx")
  @@map("countries")
}

model Department {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  name           String         @db.VarChar(80)
  abbreviation   String         @unique(map: "departments_abbreviation_key") @db.VarChar(10)
  mhCode         String         @unique(map: "departments_mh_code_key") @map("mh_code") @db.VarChar(5)
  zone           Int            @db.UnsignedTinyInt
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  municipalities Municipality[]
  companies      Company[]
  branches       Branch[]
  suppliers      Supplier[]

  @@index([isActive, name], map: "departments_active_name_idx")
  @@map("departments")
}

model Municipality {
  id           Int        @id @default(autoincrement()) @db.UnsignedInt
  departmentId Int        @map("department_id") @db.UnsignedInt
  name         String     @db.VarChar(80)
  mhCode       String     @map("mh_code") @db.VarChar(5)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  districts    District[]
  companies    Company[]
  branches     Branch[]
  suppliers    Supplier[]

  @@unique([departmentId, mhCode], map: "municipalities_department_mh_code_key")
  @@index([departmentId, isActive, name], map: "municipalities_department_active_name_idx")
  @@map("municipalities")
}

model District {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  municipalityId Int          @map("municipality_id") @db.UnsignedInt
  name           String       @db.VarChar(100)
  mhCode         String       @map("mh_code") @db.VarChar(5)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  companies      Company[]
  branches       Branch[]
  suppliers      Supplier[]

  @@unique([municipalityId, mhCode], map: "districts_municipality_mh_code_key")
  @@index([municipalityId, isActive, name], map: "districts_municipality_active_name_idx")
  @@map("districts")
}

model EconomicActivity {
  id        Int                       @id @default(autoincrement()) @db.UnsignedInt
  code      String                    @unique(map: "economic_activities_code_key") @db.VarChar(30)
  name      String                    @db.VarChar(512)
  isActive  Boolean                   @default(true) @map("is_active")
  createdAt DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  companies CompanyEconomicActivity[]

  @@index([isActive, name], map: "economic_activities_active_name_idx")
  @@map("economic_activities")
}

model MeasurementUnit {
  id           Int           @id @default(autoincrement()) @db.UnsignedInt
  name         String        @unique(map: "measurement_units_name_key") @db.VarChar(64)
  pluralName   String?       @map("plural_name") @db.VarChar(64)
  symbol       String?       @db.VarChar(32)
  mhCode       String?       @unique(map: "measurement_units_mh_code_key") @map("mh_code") @db.VarChar(3)
  comments     String?       @db.VarChar(1024)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  productUnits ProductUnit[]

  @@index([isActive, name], map: "measurement_units_active_name_idx")
  @@map("measurement_units")
}

model Company {
  id                              Int                              @id @default(autoincrement()) @db.UnsignedInt
  code                            String                           @unique(map: "companies_code_key") @db.VarChar(50)
  legalName                       String                           @map("legal_name") @db.VarChar(191)
  commercialName                  String                           @map("commercial_name") @db.VarChar(191)
  nit                             String                           @unique(map: "companies_nit_key") @db.VarChar(25)
  nrc                             String                           @unique(map: "companies_nrc_key") @db.VarChar(25)
  countryId                       Int                              @map("country_id") @db.UnsignedInt
  departmentId                    Int?                             @map("department_id") @db.UnsignedInt
  municipalityId                  Int?                             @map("municipality_id") @db.UnsignedInt
  districtId                      Int?                             @map("district_id") @db.UnsignedInt
  foreignAdministrativeArea       String?                          @map("foreign_administrative_area") @db.VarChar(191)
  foreignLocality                 String?                          @map("foreign_locality") @db.VarChar(191)
  addressLine                     String                           @map("address_line") @db.VarChar(500)
  phone                           String?                          @db.VarChar(30)
  email                           String?                          @db.VarChar(191)
  website                         String?                          @db.VarChar(500)
  logoStorageKey                  String?                          @map("logo_storage_key") @db.VarChar(500)
  status                          CompanyStatus                    @default(ACTIVE)
  defaultCurrencyCode             String                           @default("USD") @map("default_currency_code") @db.Char(3)
  timezone                        String                           @default("America/El_Salvador") @db.VarChar(100)
  locale                          String                           @default("es-SV") @db.VarChar(20)
  createdAt                       DateTime                         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                       DateTime                         @updatedAt @map("updated_at") @db.DateTime(3)
  country                         Country                          @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department                      Department?                      @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  municipality                    Municipality?                    @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district                        District?                        @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  economicActivities              CompanyEconomicActivity[]
  memberships                     CompanyMembership[]
  roles                           CompanyRole[]
  sessions                        AuthSession[]
  auditLogs                       AuditLog[]
  entityChanges                   EntityChangeLog[]
  branches                        Branch[]
  invitations                     CompanyInvitation[]
  warehouseCategories             WarehouseCategory[]
  warehouses                      Warehouse[]
  locations                       Location[]
  suppliers                       Supplier[]
  supplierContacts                SupplierContact[]
  brands                          Brand[]
  productCategories               ProductCategory[]
  productUnits                    ProductUnit[]
  products                        Product[]
  productImages                   ProductImage[]
  purchaseRequests                PurchaseRequest[]
  purchaseRequestDetails          PurchaseRequestDetail[]
  expenseTypes                    ExpenseType[]
  purchaseQuotations              PurchaseQuotation[]
  purchaseQuotationDetails        PurchaseQuotationDetail[]
  purchaseQuotationRequests       PurchaseQuotationRequest[]
  purchaseQuotationRequestDetails PurchaseQuotationRequestDetail[]
  purchaseQuotationExpenses       PurchaseQuotationExpense[]

  @@index([status, legalName], map: "companies_status_legal_name_idx")
  @@index([countryId], map: "companies_country_id_idx")
  @@index([departmentId], map: "companies_department_id_idx")
  @@index([municipalityId], map: "companies_municipality_id_idx")
  @@index([districtId], map: "companies_district_id_idx")
  @@map("companies")
}

model ProductUnit {
  id                       Int                       @id @default(autoincrement()) @db.UnsignedInt
  companyId                Int                       @map("company_id") @db.UnsignedInt
  measurementUnitId        Int                       @map("measurement_unit_id") @db.UnsignedInt
  code                     String                    @db.VarChar(50)
  name                     String                    @db.VarChar(120)
  type                     ProductUnitType
  description              String?                   @db.VarChar(500)
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  company                  Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  measurementUnit          MeasurementUnit           @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  purchaseProducts         Product[]                 @relation("ProductPurchaseUnit")
  saleProducts             Product[]                 @relation("ProductSaleUnit")
  purchaseRequestDetails   PurchaseRequestDetail[]
  purchaseQuotationDetails PurchaseQuotationDetail[]

  @@unique([companyId, code], map: "product_units_company_code_key")
  @@unique([companyId, type, name], map: "product_units_company_type_name_key")
  @@unique([id, companyId], map: "product_units_id_company_key")
  @@index([companyId, type, isActive, name], map: "product_units_company_type_active_name_idx")
  @@index([measurementUnitId], map: "product_units_measurement_unit_id_idx")
  @@map("product_units")
}

model Brand {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt
  companyId      Int       @map("company_id") @db.UnsignedInt
  code           String    @db.VarChar(50)
  name           String    @db.VarChar(120)
  description    String?   @db.VarChar(500)
  website        String?   @db.VarChar(500)
  logoStorageKey String?   @map("logo_storage_key") @db.VarChar(500)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products       Product[]

  @@unique([companyId, code], map: "brands_company_code_key")
  @@unique([companyId, name], map: "brands_company_name_key")
  @@unique([id, companyId], map: "brands_id_company_key")
  @@index([companyId, isActive, name], map: "brands_company_active_name_idx")
  @@map("brands")
}

model ProductCategory {
  id               Int               @id @default(autoincrement()) @db.UnsignedInt
  companyId        Int               @map("company_id") @db.UnsignedInt
  parentCategoryId Int?              @map("parent_category_id") @db.UnsignedInt
  parentScopeId    Int               @default(0) @map("parent_scope_id") @db.UnsignedInt
  code             String            @db.VarChar(50)
  name             String            @db.VarChar(120)
  nameKey          String            @map("name_key") @db.VarChar(120)
  description      String?           @db.VarChar(500)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parent           ProductCategory?  @relation("ProductCategoryHierarchy", fields: [parentCategoryId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  children         ProductCategory[] @relation("ProductCategoryHierarchy")
  products         Product[]

  @@unique([companyId, code], map: "product_categories_company_code_key")
  @@unique([companyId, parentScopeId, nameKey], map: "product_categories_sibling_name_key")
  @@unique([id, companyId], map: "product_categories_id_company_key")
  @@index([companyId, parentCategoryId, isActive, name], map: "product_categories_parent_active_name_idx")
  @@map("product_categories")
}

model Product {
