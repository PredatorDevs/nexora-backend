generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

enum AuditResult {
  SUCCESS
  FAILURE

  @@map("audit_result")
}

enum EntityChangeOperation {
  CREATE
  UPDATE
  DELETE

  @@map("entity_change_operation")
}

enum EntityChangeSource {
  APPLICATION
  SYSTEM_JOB
  MIGRATION
  DATABASE_TRIGGER

  @@map("entity_change_source")
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("company_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("branch_status")
}

enum LocationCapacityUnit {
  UNITS
  KG
  M3
  PALLETS
}

enum CompanyEconomicActivityType {
  PRIMARY
  SECONDARY
  TERTIARY

  @@map("company_economic_activity_type")
}

enum PermissionScope {
  PLATFORM
  COMPANY

  @@map("permission_scope")
}

enum CompanyMembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("company_membership_status")
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED

  @@map("company_invitation_status")
}

model User {
  id                         Int                     @id @default(autoincrement()) @db.UnsignedInt
  email                      String                  @unique(map: "users_email_key") @db.VarChar(191)
  passwordHash               String                  @map("password_hash") @db.VarChar(255)
  displayName                String                  @map("display_name") @db.VarChar(120)
  status                     UserStatus              @default(ACTIVE)
  securityVersion            Int                     @default(1) @map("security_version") @db.UnsignedInt
  mustChangePassword         Boolean                 @default(false) @map("must_change_password")
  createdAt                  DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  roles                      UserRole[]              @relation("UserRoles")
  roleAssignmentsGranted     UserRole[]              @relation("UserRoleAssignedBy")
  permissionGrantsAssigned   RolePermission[]        @relation("RolePermissionAssignedBy")
  sessions                   AuthSession[]
  auditLogs                  AuditLog[]              @relation("AuditActor")
  entityChanges              EntityChangeLog[]       @relation("EntityChangeActor")
  companyMemberships         CompanyMembership[]
  companyRolesAssigned       CompanyMembershipRole[] @relation("CompanyMembershipRoleAssignedBy")
  companyPermissionsAssigned CompanyRolePermission[] @relation("CompanyRolePermissionAssignedBy")
  companyInvitationsSent     CompanyInvitation[]     @relation("CompanyInvitationInvitedBy")
  companyInvitationsAccepted CompanyInvitation[]     @relation("CompanyInvitationAcceptedBy")

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement()) @db.UnsignedInt
  code        String           @unique(map: "roles_code_key") @db.VarChar(100)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  users       UserRole[]
  permissions RolePermission[]

  @@index([isSystem], map: "roles_is_system_idx")
  @@map("roles")
}

model Permission {
  id           Int                     @id @default(autoincrement()) @db.UnsignedInt
  code         String                  @unique(map: "permissions_code_key") @db.VarChar(150)
  resource     String                  @db.VarChar(75)
  action       String                  @db.VarChar(75)
  description  String?                 @db.VarChar(500)
  scope        PermissionScope         @default(PLATFORM)
  createdAt    DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  roles        RolePermission[]
  companyRoles CompanyRolePermission[]

  @@unique([resource, action], map: "permissions_resource_action_key")
  @@map("permissions")
}

model UserRole {
  userId           Int      @map("user_id") @db.UnsignedInt
  roleId           Int      @map("role_id") @db.UnsignedInt
  assignedByUserId Int?     @map("assigned_by_user_id") @db.UnsignedInt
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  user             User     @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy       User?    @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId], map: "user_roles_role_id_idx")
  @@index([assignedByUserId], map: "user_roles_assigned_by_user_id_idx")
  @@map("user_roles")
}

model RolePermission {
  roleId           Int        @map("role_id") @db.UnsignedInt
  permissionId     Int        @map("permission_id") @db.UnsignedInt
  assignedByUserId Int?       @map("assigned_by_user_id") @db.UnsignedInt
  assignedAt       DateTime   @default(now()) @map("assigned_at") @db.DateTime(3)
  role             Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission       Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedBy       User?      @relation("RolePermissionAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "role_permissions_permission_id_idx")
  @@index([assignedByUserId], map: "role_permissions_assigned_by_user_id_idx")
  @@map("role_permissions")
}

model AuthSession {
  id               String             @id @db.Char(36)
  familyId         String             @map("family_id") @db.Char(36)
  userId           Int                @map("user_id") @db.UnsignedInt
  companyId        Int?               @map("company_id") @db.UnsignedInt
  membershipId     Int?               @map("membership_id") @db.UnsignedInt
  refreshTokenHash String             @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Char(64)
  ipAddress        String?            @map("ip_address") @db.VarChar(45)
  userAgent        String?            @map("user_agent") @db.VarChar(512)
  expiresAt        DateTime           @map("expires_at") @db.DateTime(3)
  lastUsedAt       DateTime?          @map("last_used_at") @db.DateTime(3)
  revokedAt        DateTime?          @map("revoked_at") @db.DateTime(3)
  revokedReason    String?            @map("revoked_reason") @db.VarChar(100)
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  membership       CompanyMembership? @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_state_idx")
  @@index([familyId], map: "auth_sessions_family_id_idx")
  @@index([expiresAt], map: "auth_sessions_expires_at_idx")
  @@index([companyId, revokedAt, expiresAt], map: "auth_sessions_company_state_idx")
  @@index([membershipId, companyId], map: "auth_sessions_membership_company_idx")
  @@map("auth_sessions")
}

model AuditLog {
  id                BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  actorUserId       Int?               @map("actor_user_id") @db.UnsignedInt
  companyId         Int?               @map("company_id") @db.UnsignedInt
  actorMembershipId Int?               @map("actor_membership_id") @db.UnsignedInt
  action            String             @db.VarChar(150)
  resourceType      String             @map("resource_type") @db.VarChar(100)
  resourceId        String?            @map("resource_id") @db.VarChar(191)
  result            AuditResult
  requestId         String             @map("request_id") @db.VarChar(128)
  ipAddress         String?            @map("ip_address") @db.VarChar(45)
  userAgent         String?            @map("user_agent") @db.VarChar(512)
  metadata          Json?
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  actor             User?              @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorMembership   CompanyMembership? @relation(fields: [actorMembershipId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId, createdAt], map: "audit_logs_actor_created_at_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_at_idx")
  @@index([resourceType, resourceId], map: "audit_logs_resource_idx")
  @@index([requestId], map: "audit_logs_request_id_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@index([companyId, createdAt], map: "audit_logs_company_created_at_idx")
  @@index([companyId, actorUserId, createdAt], map: "audit_logs_company_actor_idx")
  @@map("audit_logs")
}

model EntityChangeLog {
  id                BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  schemaName        String                @map("schema_name") @db.VarChar(100)
  entityType        String                @map("entity_type") @db.VarChar(100)
  entityId          String                @map("entity_id") @db.VarChar(191)
  operation         EntityChangeOperation
  source            EntityChangeSource    @default(APPLICATION)
  actorUserId       Int?                  @map("actor_user_id") @db.UnsignedInt
  companyId         Int?                  @map("company_id") @db.UnsignedInt
  actorMembershipId Int?                  @map("actor_membership_id") @db.UnsignedInt
  requestId         String                @map("request_id") @db.VarChar(128)
  oldValues         Json?                 @map("old_values")
  newValues         Json?                 @map("new_values")
  changedFields     Json?                 @map("changed_fields")
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  actor             User?                 @relation("EntityChangeActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  company           Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actorMembership   CompanyMembership?    @relation(fields: [actorMembershipId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@index([schemaName, entityType, entityId, createdAt], map: "entity_change_logs_entity_idx")
  @@index([schemaName, createdAt], map: "entity_change_logs_schema_date_idx")
  @@index([schemaName, entityType, createdAt], map: "entity_change_logs_type_date_idx")
  @@index([actorUserId, createdAt], map: "entity_change_logs_actor_idx")
  @@index([requestId], map: "entity_change_logs_request_id_idx")
  @@index([createdAt], map: "entity_change_logs_created_at_idx")
  @@index([companyId, createdAt], map: "entity_change_logs_company_date_idx")
  @@index([companyId, entityType, entityId, createdAt], map: "entity_change_logs_company_entity_idx")
  @@map("entity_change_logs")
}

model Country {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  name         String    @db.VarChar(128)
  abbreviation String    @unique(map: "countries_abbreviation_key") @db.VarChar(5)
  mhCode       String    @unique(map: "countries_mh_code_key") @map("mh_code") @db.VarChar(5)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  companies    Company[]
  branches     Branch[]
  suppliers    Supplier[]

  @@index([isActive, name], map: "countries_active_name_idx")
  @@map("countries")
}

model Department {
  id             Int            @id @default(autoincrement()) @db.UnsignedInt
  name           String         @db.VarChar(80)
  abbreviation   String         @unique(map: "departments_abbreviation_key") @db.VarChar(10)
  mhCode         String         @unique(map: "departments_mh_code_key") @map("mh_code") @db.VarChar(5)
  zone           Int            @db.UnsignedTinyInt
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  municipalities Municipality[]
  companies      Company[]
  branches       Branch[]
  suppliers      Supplier[]

  @@index([isActive, name], map: "departments_active_name_idx")
  @@map("departments")
}

model Municipality {
  id           Int        @id @default(autoincrement()) @db.UnsignedInt
  departmentId Int        @map("department_id") @db.UnsignedInt
  name         String     @db.VarChar(80)
  mhCode       String     @map("mh_code") @db.VarChar(5)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  districts    District[]
  companies    Company[]
  branches     Branch[]
  suppliers    Supplier[]

  @@unique([departmentId, mhCode], map: "municipalities_department_mh_code_key")
  @@index([departmentId, isActive, name], map: "municipalities_department_active_name_idx")
  @@map("municipalities")
}

model District {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  municipalityId Int          @map("municipality_id") @db.UnsignedInt
  name           String       @db.VarChar(100)
  mhCode         String       @map("mh_code") @db.VarChar(5)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  companies      Company[]
  branches       Branch[]
  suppliers      Supplier[]

  @@unique([municipalityId, mhCode], map: "districts_municipality_mh_code_key")
  @@index([municipalityId, isActive, name], map: "districts_municipality_active_name_idx")
  @@map("districts")
}

model EconomicActivity {
  id        Int                       @id @default(autoincrement()) @db.UnsignedInt
  code      String                    @unique(map: "economic_activities_code_key") @db.VarChar(30)
  name      String                    @db.VarChar(512)
  isActive  Boolean                   @default(true) @map("is_active")
  createdAt DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  companies CompanyEconomicActivity[]

  @@index([isActive, name], map: "economic_activities_active_name_idx")
  @@map("economic_activities")
}

model Company {
  id                        Int                       @id @default(autoincrement()) @db.UnsignedInt
  code                      String                    @unique(map: "companies_code_key") @db.VarChar(50)
  legalName                 String                    @map("legal_name") @db.VarChar(191)
  commercialName            String                    @map("commercial_name") @db.VarChar(191)
  nit                       String                    @unique(map: "companies_nit_key") @db.VarChar(25)
  nrc                       String                    @unique(map: "companies_nrc_key") @db.VarChar(25)
  countryId                 Int                       @map("country_id") @db.UnsignedInt
  departmentId              Int?                      @map("department_id") @db.UnsignedInt
  municipalityId            Int?                      @map("municipality_id") @db.UnsignedInt
  districtId                Int?                      @map("district_id") @db.UnsignedInt
  foreignAdministrativeArea String?                   @map("foreign_administrative_area") @db.VarChar(191)
  foreignLocality           String?                   @map("foreign_locality") @db.VarChar(191)
  addressLine               String                    @map("address_line") @db.VarChar(500)
  phone                     String?                   @db.VarChar(30)
  email                     String?                   @db.VarChar(191)
  website                   String?                   @db.VarChar(500)
  logoStorageKey            String?                   @map("logo_storage_key") @db.VarChar(500)
  status                    CompanyStatus             @default(ACTIVE)
  defaultCurrencyCode       String                    @default("USD") @map("default_currency_code") @db.Char(3)
  timezone                  String                    @default("America/El_Salvador") @db.VarChar(100)
  locale                    String                    @default("es-SV") @db.VarChar(20)
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  country                   Country                   @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department                Department?               @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  municipality              Municipality?             @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district                  District?                 @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  economicActivities        CompanyEconomicActivity[]
  memberships               CompanyMembership[]
  roles                     CompanyRole[]
  sessions                  AuthSession[]
  auditLogs                 AuditLog[]
  entityChanges             EntityChangeLog[]
  branches                  Branch[]
  invitations               CompanyInvitation[]
  warehouseCategories       WarehouseCategory[]
  warehouses                Warehouse[]
  locations                 Location[]
  suppliers                 Supplier[]
  supplierContacts          SupplierContact[]

  @@index([status, legalName], map: "companies_status_legal_name_idx")
  @@index([countryId], map: "companies_country_id_idx")
  @@index([departmentId], map: "companies_department_id_idx")
  @@index([municipalityId], map: "companies_municipality_id_idx")
  @@index([districtId], map: "companies_district_id_idx")
  @@map("companies")
}

model CodeSequence {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  namespace String   @unique(map: "code_sequences_namespace_key") @db.VarChar(191)
  nextValue BigInt   @default(1) @map("next_value") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("code_sequences")
}

model Branch {
  id                        Int           @id @default(autoincrement()) @db.UnsignedInt
  companyId                 Int           @map("company_id") @db.UnsignedInt
  code                      String        @db.VarChar(50)
  name                      String        @db.VarChar(191)
  isHeadquarters            Boolean       @default(false) @map("is_headquarters")
  countryId                 Int           @map("country_id") @db.UnsignedInt
  departmentId              Int?          @map("department_id") @db.UnsignedInt
  municipalityId            Int?          @map("municipality_id") @db.UnsignedInt
  districtId                Int?          @map("district_id") @db.UnsignedInt
  foreignAdministrativeArea String?       @map("foreign_administrative_area") @db.VarChar(191)
  foreignLocality           String?       @map("foreign_locality") @db.VarChar(191)
  addressLine               String        @map("address_line") @db.VarChar(500)
  phone                     String?       @db.VarChar(30)
  email                     String?       @db.VarChar(191)
  status                    BranchStatus  @default(ACTIVE)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  company                   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  country                   Country       @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department                Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  municipality              Municipality? @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district                  District?     @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouses                Warehouse[]

  @@unique([companyId, code], map: "branches_company_code_key")
  @@unique([companyId, name], map: "branches_company_name_key")
  @@unique([id, companyId], map: "branches_id_company_key")
  @@index([companyId, status, name], map: "branches_company_status_name_idx")
  @@index([companyId, isHeadquarters], map: "branches_company_headquarters_idx")
  @@index([countryId], map: "branches_country_id_idx")
  @@index([departmentId], map: "branches_department_id_idx")
  @@index([municipalityId], map: "branches_municipality_id_idx")
  @@index([districtId], map: "branches_district_id_idx")
  @@map("branches")
}

model WarehouseCategory {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  companyId   Int      @map("company_id") @db.UnsignedInt
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouses  Warehouse[]

  @@unique([companyId, code], map: "warehouse_categories_company_code_key")
  @@unique([companyId, name], map: "warehouse_categories_company_name_key")
  @@unique([id, companyId], map: "warehouse_categories_id_company_key")
  @@index([companyId, isActive, name], map: "warehouse_categories_company_active_name_idx")
  @@map("warehouse_categories")
}

model Warehouse {
  id                  Int               @id @default(autoincrement()) @db.UnsignedInt
  companyId           Int               @map("company_id") @db.UnsignedInt
  branchId            Int               @map("branch_id") @db.UnsignedInt
  warehouseCategoryId Int               @map("warehouse_category_id") @db.UnsignedInt
  code                String            @db.VarChar(50)
  name                String            @db.VarChar(191)
  description         String?           @db.VarChar(500)
  isActive            Boolean           @default(true) @map("is_active")
  createdAt           DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch              Branch            @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  warehouseCategory   WarehouseCategory @relation(fields: [warehouseCategoryId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)
  locations           Location[]

  @@unique([companyId, code], map: "warehouses_company_code_key")
  @@unique([companyId, branchId, name], map: "warehouses_company_branch_name_key")
  @@unique([id, companyId], map: "warehouses_id_company_key")
  @@index([companyId, branchId, isActive, name], map: "warehouses_company_branch_active_name_idx")
  @@index([companyId, warehouseCategoryId], map: "warehouses_company_category_idx")
  @@map("warehouses")
}

model Location {
  id           Int                   @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int                   @map("company_id") @db.UnsignedInt
  warehouseId  Int                   @map("warehouse_id") @db.UnsignedInt
  code         String                @db.VarChar(50)
  aisle        String                @db.VarChar(50)
  rack         String                @db.VarChar(50)
  level        String                @db.VarChar(50)
  position     String                @db.VarChar(50)
  capacity     Decimal?              @db.Decimal(18, 4)
  capacityUnit LocationCapacityUnit? @map("capacity_unit")
  notes        String?               @db.Text
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouse    Warehouse             @relation(fields: [warehouseId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([companyId, warehouseId, code], map: "locations_company_warehouse_code_key")
  @@unique([companyId, warehouseId, aisle, rack, level, position], map: "locations_physical_coordinates_key")
  @@unique([id, companyId], map: "locations_id_company_key")
  @@index([companyId, warehouseId, isActive, code], map: "locations_company_warehouse_active_code_idx")
  @@map("locations")
}

model Supplier {
  id                        Int               @id @default(autoincrement()) @db.UnsignedInt
  companyId                 Int               @map("company_id") @db.UnsignedInt
  code                      String            @db.VarChar(50)
  name                      String            @db.VarChar(191)
  nit                       String?           @db.VarChar(25)
  nrc                       String?           @db.VarChar(25)
  countryId                 Int               @map("country_id") @db.UnsignedInt
  departmentId              Int?              @map("department_id") @db.UnsignedInt
  municipalityId            Int?              @map("municipality_id") @db.UnsignedInt
  districtId                Int?              @map("district_id") @db.UnsignedInt
  foreignAdministrativeArea String?           @map("foreign_administrative_area") @db.VarChar(191)
  foreignLocality           String?           @map("foreign_locality") @db.VarChar(191)
  addressLine               String            @map("address_line") @db.VarChar(500)
  phone                     String?           @db.VarChar(30)
  email                     String?           @db.VarChar(191)
  website                   String?           @db.VarChar(500)
  isActive                  Boolean           @default(true) @map("is_active")
  createdAt                 DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  company                   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  country                   Country           @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  department                Department?       @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  municipality              Municipality?     @relation(fields: [municipalityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district                  District?         @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contacts                  SupplierContact[]

  @@unique([companyId, code], map: "suppliers_company_code_key")
  @@unique([companyId, countryId, nit], map: "suppliers_company_country_nit_key")
  @@unique([companyId, countryId, nrc], map: "suppliers_company_country_nrc_key")
  @@unique([id, companyId], map: "suppliers_id_company_key")
  @@index([companyId, isActive, name], map: "suppliers_company_active_name_idx")
  @@index([countryId], map: "suppliers_country_id_idx")
  @@index([departmentId], map: "suppliers_department_id_idx")
  @@index([municipalityId], map: "suppliers_municipality_id_idx")
  @@index([districtId], map: "suppliers_district_id_idx")
  @@map("suppliers")
}

model SupplierContact {
  id           Int       @id @default(autoincrement()) @db.UnsignedInt
  companyId    Int       @map("company_id") @db.UnsignedInt
  supplierId   Int       @map("supplier_id") @db.UnsignedInt
  fullName     String    @map("full_name") @db.VarChar(191)
  jobTitle     String?   @map("job_title") @db.VarChar(120)
  department   String?   @db.VarChar(120)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(191)
  isPrimary    Boolean   @default(false) @map("is_primary")
  validFrom    DateTime  @default(now()) @map("valid_from") @db.DateTime(3)
  validUntil   DateTime? @map("valid_until") @db.DateTime(3)
  notes        String?   @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier     Supplier  @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([id, companyId], map: "supplier_contacts_id_company_key")
  @@index([companyId, supplierId, isActive, isPrimary], map: "supplier_contacts_supplier_active_primary_idx")
  @@index([companyId, email], map: "supplier_contacts_company_email_idx")
  @@map("supplier_contacts")
}

model CompanyMembership {
  id              Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId       Int                     @map("company_id") @db.UnsignedInt
  userId          Int                     @map("user_id") @db.UnsignedInt
  status          CompanyMembershipStatus @default(ACTIVE)
  securityVersion Int                     @default(1) @map("security_version") @db.UnsignedInt
  joinedAt        DateTime                @default(now()) @map("joined_at") @db.DateTime(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  company         Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  roles           CompanyMembershipRole[]
  sessions        AuthSession[]
  auditLogs       AuditLog[]
  entityChanges   EntityChangeLog[]

  @@unique([companyId, userId], map: "company_memberships_company_user_key")
  @@unique([id, companyId], map: "company_memberships_id_company_key")
  @@index([userId, status], map: "company_memberships_user_status_idx")
  @@index([companyId, status], map: "company_memberships_company_status_idx")
  @@map("company_memberships")
}

model CompanyInvitation {
  id               Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId        Int                     @map("company_id") @db.UnsignedInt
  email            String                  @db.VarChar(191)
  tokenHash        String                  @unique(map: "company_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  status           CompanyInvitationStatus @default(PENDING)
  expiresAt        DateTime                @map("expires_at") @db.DateTime(3)
  invitedByUserId  Int                     @map("invited_by_user_id") @db.UnsignedInt
  acceptedByUserId Int?                    @map("accepted_by_user_id") @db.UnsignedInt
  acceptedAt       DateTime?               @map("accepted_at") @db.DateTime(3)
  revokedAt        DateTime?               @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedBy        User                    @relation("CompanyInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?                   @relation("CompanyInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  roles            CompanyInvitationRole[]

  @@unique([id, companyId], map: "company_invitations_id_company_key")
  @@index([companyId, status, createdAt], map: "company_invitations_company_status_idx")
  @@index([email, status], map: "company_invitations_email_status_idx")
  @@index([expiresAt, status], map: "company_invitations_expiry_status_idx")
  @@map("company_invitations")
}

model CompanyInvitationRole {
  invitationId Int               @map("invitation_id") @db.UnsignedInt
  roleId       Int               @map("role_id") @db.UnsignedInt
  companyId    Int               @map("company_id") @db.UnsignedInt
  invitation   CompanyInvitation @relation(fields: [invitationId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  role         CompanyRole       @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)

  @@id([invitationId, roleId])
  @@index([roleId, companyId], map: "company_invitation_roles_role_company_idx")
  @@index([companyId], map: "company_invitation_roles_company_idx")
  @@map("company_invitation_roles")
}

model CompanyRole {
  id          Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId   Int                     @map("company_id") @db.UnsignedInt
  code        String                  @db.VarChar(100)
  name        String                  @db.VarChar(120)
  description String?                 @db.VarChar(500)
  isSystem    Boolean                 @default(false) @map("is_system")
  createdAt   DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships CompanyMembershipRole[]
  permissions CompanyRolePermission[]
  invitations CompanyInvitationRole[]

  @@unique([companyId, code], map: "company_roles_company_code_key")
  @@unique([id, companyId], map: "company_roles_id_company_key")
  @@index([companyId, isSystem], map: "company_roles_company_system_idx")
  @@map("company_roles")
}

model CompanyMembershipRole {
  membershipId     Int               @map("membership_id") @db.UnsignedInt
  roleId           Int               @map("role_id") @db.UnsignedInt
  companyId        Int               @map("company_id") @db.UnsignedInt
  assignedByUserId Int?              @map("assigned_by_user_id") @db.UnsignedInt
  assignedAt       DateTime          @default(now()) @map("assigned_at") @db.DateTime(3)
  membership       CompanyMembership @relation(fields: [membershipId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  role             CompanyRole       @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  assignedBy       User?             @relation("CompanyMembershipRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([membershipId, roleId])
  @@index([roleId, companyId], map: "company_membership_roles_role_company_idx")
  @@index([companyId], map: "company_membership_roles_company_idx")
  @@index([assignedByUserId], map: "company_membership_roles_assigned_by_idx")
  @@map("company_membership_roles")
}

model CompanyRolePermission {
  roleId           Int         @map("role_id") @db.UnsignedInt
  permissionId     Int         @map("permission_id") @db.UnsignedInt
  companyId        Int         @map("company_id") @db.UnsignedInt
  assignedByUserId Int?        @map("assigned_by_user_id") @db.UnsignedInt
  assignedAt       DateTime    @default(now()) @map("assigned_at") @db.DateTime(3)
  role             CompanyRole @relation(fields: [roleId, companyId], references: [id, companyId], onDelete: Cascade, onUpdate: Cascade)
  permission       Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedBy       User?       @relation("CompanyRolePermissionAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "company_role_permissions_permission_idx")
  @@index([companyId], map: "company_role_permissions_company_idx")
  @@index([assignedByUserId], map: "company_role_permissions_assigned_by_idx")
  @@map("company_role_permissions")
}

model CompanyEconomicActivity {
  companyId          Int                         @map("company_id") @db.UnsignedInt
  economicActivityId Int                         @map("economic_activity_id") @db.UnsignedInt
  type               CompanyEconomicActivityType
  createdAt          DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  company            Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  economicActivity   EconomicActivity            @relation(fields: [economicActivityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([companyId, type])
  @@unique([companyId, economicActivityId], map: "company_economic_activities_activity_key")
  @@index([economicActivityId], map: "company_economic_activities_activity_id_idx")
  @@map("company_economic_activities")
}
