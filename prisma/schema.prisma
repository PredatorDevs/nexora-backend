model CompanyInvitation {
  id               Int                     @id @default(autoincrement()) @db.UnsignedInt
  companyId        Int                     @map("company_id") @db.UnsignedInt
  email            String                  @db.VarChar(191)
  tokenHash        String                  @unique(map: "company_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  status           CompanyInvitationStatus @default(PENDING)
  expiresAt        DateTime                @map("expires_at") @db.DateTime(3)
  invitedByUserId  Int                     @map("invited_by_user_id") @db.UnsignedInt
  acceptedByUserId Int?                    @map("accepted_by_user_id") @db.UnsignedInt
  acceptedAt       DateTime?               @map("accepted_at") @db.DateTime(3)
  revokedAt        DateTime?               @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedBy        User                    @relation("CompanyInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?                   @relation("CompanyInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  roles            CompanyInvitationRole[]

  @@unique([id, companyId], map: "company_invitations_id_company_key")
  @@index([companyId, status, createdAt], map: "company_invitations_company_status_idx")
  @@index([email, status], map: "company_invitations_email_status_idx")
  @@index([expiresAt, status], map: "company_invitations_expiry_status_idx")
  @@map("company_invitations")
}

model CompanyInvitationRole {
